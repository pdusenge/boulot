# syntax=docker/dockerfile:1

FROM node:20-alpine AS build
WORKDIR /repo

# Install dependencies for the whole monorepo (workspaces)
COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/utils/package.json packages/utils/package.json
COPY packages/ui/package.json packages/ui/package.json

RUN npm ci

# Copy source and build server + shared packages
COPY . .
RUN npm run build -w packages/types \
  && npm run build -w packages/utils \
  && npm run build -w packages/ui \
  && npm run build -w apps/server

# Create a production-only node_modules tree (still workspace-aware)
RUN npm prune --omit=dev

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /repo/apps/server/dist ./dist
COPY --from=build /repo/apps/server/package.json ./package.json
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/packages ./packages

EXPOSE 3001
CMD ["node", "dist/index.js"]

