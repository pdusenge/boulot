# syntax=docker/dockerfile:1

FROM node:20-alpine AS build
WORKDIR /repo

# Build-time public env vars for Next.js
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Install dependencies for the whole monorepo (workspaces)
COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/utils/package.json packages/utils/package.json
COPY packages/ui/package.json packages/ui/package.json

RUN npm ci

# Copy source and build web + shared packages
COPY . .
RUN npm run build -w packages/types \
  && npm run build -w packages/utils \
  && npm run build -w packages/ui \
  && npm run build -w apps/web

# Create a production-only node_modules tree
RUN npm prune --omit=dev

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

# Keep env for runtime usage too (some code may read it server-side)
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

COPY --from=build /repo/apps/web/.next ./.next
COPY --from=build /repo/apps/web/public ./public
COPY --from=build /repo/apps/web/package.json ./package.json

COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/packages ./packages

EXPOSE 3000
CMD ["node_modules/.bin/next", "start", "-p", "3000"]

